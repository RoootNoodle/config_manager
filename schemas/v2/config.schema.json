{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MIOT Gateway Configuration Schema v2",
  "description": "Gateway config file (config_v2.json) and the result of every v2/cfg/set patch. Unknown keys are rejected at every level.",
  "type": "object",
  "required": ["s", "v", "id", "n", "u"],
  "additionalProperties": false,
  "properties": {
    "s": {
      "description": "Schema version",
      "const": 2
    },
    "v": {
      "type": "integer",
      "description": "Config version counter. A patch must carry a higher value than the stored one.",
      "minimum": 0,
      "maximum": 2147483647
    },
    "id": {
      "type": "string",
      "description": "Device ID. Used in MQTT topics, so no '/', '+', '#' or control characters.",
      "pattern": "^[^/+#\\u0000-\\u001f\\u007f]*$"
    },
    "n": {
      "type": "string",
      "description": "Gateway name. The firmware limit is 39 bytes of UTF-8.",
      "maxLength": 39
    },
    "gps": {
      "description": "GNSS on (1) or off (0). Default 0.",
      "enum": [0, 1]
    },
    "cu": {
      "type": "object",
      "description": "Sensor type -> register that holds the unit address. Default empty.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "u": {
      "type": "object",
      "description": "Units keyed \"1\"-\"255\". A key is never changed or reused on a gateway.",
      "propertyNames": {
        "pattern": "^([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/unit"
      }
    }
  },
  "definitions": {
    "unit": {
      "type": "object",
      "required": ["n", "a", "io"],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "string",
          "description": "Unit name"
        },
        "ty": {
          "type": "string",
          "description": "Sensor type, a key of cu"
        },
        "a": {
          "type": "integer",
          "description": "Modbus address",
          "minimum": 2,
          "maximum": 247
        },
        "w": {
          "type": "integer",
          "description": "Publish interval on WiFi, seconds. Default 60.",
          "minimum": 1,
          "maximum": 65535
        },
        "c": {
          "type": "integer",
          "description": "Publish interval on cellular (NB-IoT), seconds. Default 300.",
          "minimum": 1,
          "maximum": 65535
        },
        "io": {
          "type": "object",
          "description": "IOs; the key is the IO name. It is used in MQTT topics, so no '/', '+', '#' or control characters.",
          "propertyNames": {
            "minLength": 1,
            "maxLength": 31,
            "pattern": "^[^/+#\\u0000-\\u001f\\u007f]+$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/io"
          }
        }
      }
    },
    "io": {
      "type": "object",
      "required": ["r", "t", "f"],
      "additionalProperties": false,
      "properties": {
        "r": {
          "type": "integer",
          "description": "Register address",
          "minimum": 0,
          "maximum": 65535
        },
        "t": {
          "description": "Value type",
          "enum": ["u16", "i16", "u32", "i32", "f32", "bool"]
        },
        "f": {
          "type": "array",
          "description": "Modbus function codes: one read code (1-4), one write code (5, 6, 15, 16), or one of each",
          "items": {
            "type": "integer",
            "enum": [1, 2, 3, 4, 5, 6, 15, 16]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "if": { "minItems": 2 },
          "then": {
            "allOf": [
              { "contains": { "enum": [1, 2, 3, 4] } },
              { "contains": { "enum": [5, 6, 15, 16] } }
            ]
          }
        },
        "b": {
          "type": "integer",
          "description": "Start byte. Default 0.",
          "minimum": 0,
          "maximum": 255
        },
        "l": {
          "type": "integer",
          "description": "Length in bytes. Default 2 for 16-bit types and bool, 4 for 32-bit types.",
          "minimum": 1,
          "maximum": 8
        },
        "e": {
          "description": "\"l\" little-endian, \"b\" big-endian. Default big-endian.",
          "enum": ["l", "b"]
        }
      }
    }
  }
}
